# Copy the values into the repository-root .env. Never commit real credentials.
# Supabase Dashboard > Project Settings > General (project ref)
SUPABASE_PROJECT_REF=

# Supabase Dashboard > Connect > Project URL and API keys
# URL example: https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server only. Dashboard > Connect > Database connection string.
# Copy the COMPLETE URI for Direct or Session pooler and replace [YOUR-PASSWORD].
# The URI includes the database username, host, port, name, and password.
# For a local persistent Node server, use Direct if IPv6 works; otherwise Session pooler.
DATABASE_URL=

# Server-only key. Never include in Flutter or public builds.
# Dashboard > Connect > Secret key (never put this in Flutter or GitHub Pages).
SUPABASE_SECRET_KEY=

# Edge/server only. Enable only after media migration, account/operations deploy,
# and scheduled cleanup-manual-media retries. Never pass to Flutter build defines.
TAP2WORK_MANUAL_MEDIA_ENABLED=false

# Account > Access Tokens; required only to apply migrations and deploy Edge Functions.
SUPABASE_ACCESS_TOKEN=

# Public native OAuth IDs only. See docs/NATIVE_AUTH_SETUP.md.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Apple .p8 / Google OAuth client secret belong in server provider/secrets settings,
# never in Flutter build defines or committed configuration.
