{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "role": {
      "type": "string",
      "const": "qa"
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "maxItems": 100
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "maxItems": 100
        }
      },
      "required": [
        "outcome",
        "checks",
        "blockers"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "role",
    "inputHash",
    "result"
  ],
  "additionalProperties": false
}
